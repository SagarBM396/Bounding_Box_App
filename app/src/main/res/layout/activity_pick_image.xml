<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:id="@+id/scrollView2">
    <LinearLayout
        android:layout_width="wrap_content"
        android:id="@+id/topLayout2"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_horizontal">
        <Button
            android:id="@+id/undo_button2"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/button_undo"
            android:drawableStart="@drawable/ic_undo_black_24dp" />

        <Spinner
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text = "@string/mode_text"
            android:id="@+id/mode_spinner2"
            tools:ignore="RelativeOverlap" />

        <Button
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:id="@+id/trash2"
            android:background="@drawable/ic_baseline_delete_24" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text = "@string/bright_text"
            android:id="@+id/brightness_btn2"
            android:drawableStart="@drawable/ic_brightness_high_black_24dp" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/contrast_text"
            android:id="@+id/contrast_btn2"
            android:drawableStart="@drawable/ic_baseline_brightness_3_24"/>

        <Button
            android:layout_width="wrap_content"
            android:scaleType="centerCrop"
            android:layout_height="match_parent"
            android:id="@+id/button_send2"
            android:text="@string/button_send"
            android:drawableStart="@drawable/ic_send_black_24dp"
            tools:ignore="RelativeOverlap" />
    </LinearLayout>
    </HorizontalScrollView>




    <com.example.myfirstapp.ShapeDrawingView
        android:id="@+id/boxView2"
        android:scaleType="centerInside"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@+id/scrollView2"
        android:layout_above="@id/pick_image_btn"/>

    <Button
        android:id="@+id/pick_image_btn"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:drawableStart="@drawable/ic_image_black_24dp"
        android:layout_alignParentBottom="true"
        android:layout_centerInParent="true"
        android:text="@string/pick_image" />



</RelativeLayout>