<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:id="@+id/scrollView">
    <LinearLayout
        android:layout_width="wrap_content"
        android:id="@+id/topLayout"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_horizontal">
        <Button
            android:id="@+id/undo_button"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:drawableStart="@drawable/ic_undo_black_24dp"
            android:text="@string/button_undo"/>

        <Spinner
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/mode_text"
            android:id="@+id/mode_spinner"
            tools:ignore="RelativeOverlap" />

        <Button
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="@drawable/ic_baseline_delete_24"
            android:id="@+id/trash"/>

        <Button
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text = "@string/bright_text"
            android:id="@+id/brightness_btn"
            android:drawableStart="@drawable/ic_brightness_high_black_24dp" />
        <Button
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/contrast_text"
            android:id="@+id/contrast_btn"
            android:drawableStart="@drawable/ic_baseline_brightness_3_24" />

        <Button
            android:layout_width="wrap_content"
            android:scaleType="centerCrop"
            android:layout_height="match_parent"
            android:id="@+id/button_send"
            android:text="@string/button_send"
            android:drawableStart="@drawable/ic_send_black_24dp"
            />
    </LinearLayout>
    </HorizontalScrollView>


    <com.example.myfirstapp.ShapeDrawingView
        android:id="@+id/boxView"
        android:scaleType="centerInside"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@+id/scrollView"
        android:layout_above="@id/capture_image_btn"/>

    <Button
        android:id="@+id/capture_image_btn"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:drawableStart = "@drawable/ic_photo_camera_black_24dp"
        android:drawablePadding="0dp"
        android:text="@string/capture_image" />


</RelativeLayout>